generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ContestStatus {
  UPCOMING
  LIVE
  CLOSED
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  name        String
  role        Role          @default(USER)
  contests    Contest[]     @relation("UserContests")
  submissions Submission[]
  scores      LeaderBoard[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Contest {
  id          String        @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      ContestStatus @default(UPCOMING)
  adminId     String
  admin       User          @relation("UserContests", fields: [adminId], references: [id])
  questions   MCQ[]
  submissions Submission[]
  leaderboard LeaderBoard[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MCQ {
  id            String       @id @default(uuid())
  question      String
  options       String[] // Array of 4 options
  correctOption Int // 0-3
  solution      String?
  contestId     String
  contest       Contest      @relation(fields: [contestId], references: [id])
  submissions   Submission[]
  createdAt     DateTime     @default(now())
}

model Submission {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  contestId  String
  contest    Contest  @relation(fields: [contestId], references: [id])
  questionId String
  question   MCQ      @relation(fields: [questionId], references: [id])
  answer     Int
  isCorrect  Boolean
  createdAt  DateTime @default(now())
}

model LeaderBoard {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id])
  score     Int
  rank      Int?
  updatedAt DateTime @updatedAt

  @@unique([userId, contestId])
}
