{
  "name": "blitzquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:live": "npm --prefix apps/liveContest run dev",
