{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "live-contest": {
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install && npm run build --workspace=live-contest"
      },
      "deploy": {
        "startCommand": "npm start --workspace=live-contest",
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "api": {
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install && npm run build --workspace=api"
      },
      "deploy": {
        "startCommand": "npm start --workspace=api",
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}